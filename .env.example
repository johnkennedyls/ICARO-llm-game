# Configuración LLM para El Escape de Ícaro
# Copia este archivo a .env y ajusta los valores

# Proveedor LLM: openai | anthropic | ollama | mock | disabled
LLM_PROVIDER=mock

# API Keys (requeridas para OpenAI/Anthropic)
LLM_API_KEY=

# Base URL (para Ollama o proxies compatibles)
LLM_BASE_URL=

# Modelos
LLM_OPERATOR_MODEL=gpt-4o-mini
LLM_ANALYST_MODEL=gpt-4o

# Parámetros de generación
LLM_TEMPERATURE=0.0
LLM_SEED=42
LLM_MAX_TOKENS=500
LLM_TIMEOUT_S=3.0
LLM_MAX_RETRIES=2